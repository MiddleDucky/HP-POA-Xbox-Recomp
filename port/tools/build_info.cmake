# Writes build_info.h for the run log's first line: which commit this exe was built from ("-dirty" with uncommitted
# changes; the toolkit and the port are one repository, so one commit names both) and on which day. Run on every
# build by the hppoa_build_info target (CMakeLists.txt), not at configure time, so the commit is never a reconfigure
# behind; the header is rewritten only when its text changes.
#   cmake -DREPO=<repository dir> -DOUT=<header> -P build_info.cmake
execute_process(COMMAND git -C "${REPO}" describe --always --dirty --abbrev=7
                OUTPUT_VARIABLE rev OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR rev STREQUAL "")
    set(rev "unknown")
endif()
# the date only: with the minute in it every build would rewrite the header and rebuild main.c
string(TIMESTAMP built "%Y-%m-%d")
set(text "// generated by tools/build_info.cmake\n#define HPPOA_GIT \"${rev}\"\n#define HPPOA_BUILT \"${built}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
